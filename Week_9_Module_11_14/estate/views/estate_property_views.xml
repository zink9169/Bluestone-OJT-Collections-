<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List view -->
    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list
                    decoration-success="state in ('offer_received','offer_accepted')"
                    decoration-muted="state == 'sold'">

                <field name="name" string="Enter your name"/>
                <field name="seller_id" string="Salesperson"/>
                <field name="property_type_id"/>
                <field name="tag_ids"
                       widget="many2many_tags"
                       options="{'color_field': 'color'}"
                string="Tags"
                />
                <field name="expected_price"/>
                <field name="best_price"/>
                <field name="selling_price"/>
                <field name="bedrooms"/>
                <field name="total_area"/>
                <field name="date_availability" optional="hide"/>
                <field name="state"/>


            </list>
        </field>
    </record>

    <!-- Form view - Odoo 19 COMPLIANT (NO ATTRS) -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form string="Property">
                <header>
                    <!-- Try with parentheses instead of brackets -->
                    <button name="action_sold" type="object" string="Set as Sold" class="btn-primary"
                            invisible="state in ('sold', 'canceled')"/>

                    <button name="action_cancel" type="object" string="Cancel" class="btn-danger"
                            invisible="state in ('sold', 'canceled')"/>

                    <field name="state" widget="statusbar"
                           statusbar_visible="new,offer_received,offer_accepted,sold,canceled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Name of the property"/>
                        </h1>
                        <field name="tag_ids" widget="many2many_tags" placeholder="Tag"/>
                    </div>

                    <!-- Top Section -->
                    <group>
                        <group>
                            <field name="description"/>
                            <field name="property_type_id" options="{'no_create': True, 'no_edit' : True}"/>
                            <field name="postcode"/>
                            <field name="date_availability"/>
                        </group>
                        <group>
                            <field name="expected_price"/>
                            <field name="best_price"/>
                            <field name="selling_price"/>
                            <field name="bedrooms"/>
                        </group>
                    </group>

                    <!-- NOTEBOOK with 3 TABS - NO ATTRS -->
                    <notebook>
                        <!-- Tab 1: Description -->
                        <page string="Description">
                            <group>
                                <field name="description"/>
                                <field name="living_area" string="Living Area (sqm)"/>
                                <field name="facades" string="Facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area" string="Garden Area (sqm)" invisible="not garden"/>
                                <field name="garden_orientation" invisible="not garden"/>
                                <field name="total_area"/>
                            </group>
                        </page>

                        <!-- Tab 2: Offers - FIXED VERSION -->
                        <page string="Offers" name="offers">
                            <field name="offer_ids" create="true"
                                   readonly="state in ('offer_accepted','sold','canceled')">
                                <list
                                        decoration-success="status == 'accepted'"
                                        decoration-danger="status == 'refused'"
                                        create="true"
                                        delete="true">
                                    <field name="partner_id"/>
                                    <field name="price"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="status" widget="badge"
                                           options="{'success': 'accepted', 'danger': 'refused', 'default': 'new'}"/>
                                    <button name="action_accept" type="object" string="Accept" class="btn-success"
                                            invisible="status == 'accepted'"/>
                                    <button name="action_refuse" type="object" string="Refuse" class="btn-danger"
                                            invisible="status == 'refused'"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <group>
                                                <field name="partner_id" required="1"/>
                                                <field name="price" required="1"/>
                                            </group>
                                            <group>
                                                <field name="validity"/>
                                                <field name="date_deadline" readonly="1"/>
                                                <field name="status" widget="radio"
                                                       options="{'success': 'accepted', 'danger': 'refused', 'default': 'new'}"/>
                                            </group>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <page string="Other Info">
                            <group>
                                <field name="seller_id" string="Salesperson"/>
                                <field name="buyer_id" string="Buyer"/>
                                <field name="property_type_id" string="Property Type"/>
                                <field name="tag_ids" widget="many2many_tags" string="Tags"/>
                                <field name="state" string="Status"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_available': 1}</field>
    </record>
</odoo>