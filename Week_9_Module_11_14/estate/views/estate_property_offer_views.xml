<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Property Offer List View -->
    <record id="view_estate_property_offer_list" model="ir.ui.view">
        <field name="name">estate.property.offer.list</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <list>
                <field name="price"/>
                <field name="partner_id"/>
                <field name="validity"/>
                <field name="date_deadline"/>
                <field name="status"/>
                <!-- Simple buttons without attrs for Odoo 19 -->
                <button name="action_accept" type="object" string="Accept" class="oe_highlight"/>
                <button name="action_refuse" type="object" string="Refuse" class="oe_stat_button"/>
            </list>
        </field>
    </record>

    <!-- Property Offer Form View -->
    <record id="view_estate_property_offer_form" model="ir.ui.view">
        <field name="name">estate.property.offer.form</field>
        <field name="model">estate.property.offer</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <!-- Simple buttons without attrs for Odoo 19 -->
                        <button name="action_accept" type="object" string="Accept" class="oe_stat_button" icon="fa-check"/>
                        <button name="action_refuse" type="object" string="Refuse" class="oe_stat_button" icon="fa-times"/>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="partner_id" placeholder="Buyer"/>
                        </h1>
                        <h2>
                            Offer: <field name="price" widget="monetary"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="price"/>
                            <field name="partner_id"/>
                            <field name="validity"/>
                        </group>
                        <group>
                            <field name="date_deadline"/>
                            <field name="status" widget="badge"
                                   decoration-info="status == 'pending'"
                                   decoration-success="status == 'accepted'"
                                   decoration-danger="status == 'refused'"/>
                            <field name="property_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>