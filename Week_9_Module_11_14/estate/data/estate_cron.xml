<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Cron job to check for expired offers - Odoo 19 format -->
        <record id="ir_cron_check_expired_offers" model="ir.cron">
            <field name="name">Check Expired Property Offers</field>
            <field name="model_id" ref="model_estate_property_offer"/>
            <field name="state">code</field>
            <field name="code">
model = env['estate.property.offer']
model._cron_check_expired_offers()
            </field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>