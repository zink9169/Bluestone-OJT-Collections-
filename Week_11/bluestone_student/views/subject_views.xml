<odoo>
    <!-- Subject Form View -->
    <record id="view_subject_form" model="ir.ui.view">
        <field name="name">bss.subject.form</field>
        <field name="model">bss.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="total_sessions" string="Total Sessions"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Optional: Subject List View -->
    <record id="view_subject_list" model="ir.ui.view">
        <field name="name">bss.subject.list</field>
        <field name="model">bss.subject</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="total_sessions"/>
            </list>
        </field>
    </record>
</odoo>
