<odoo>
    <record id="view_attendance_form" model="ir.ui.view">
        <field name="name">bss.attendance.form</field>
        <field name="model">bss.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="attendance_number" readonly="1"/>
                        <field name="student_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
