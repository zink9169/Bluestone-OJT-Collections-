<odoo>
    <!-- Attendance List View (editable inline for teachers) -->
    <record id="view_attendance_list" model="ir.ui.view">
        <field name="name">bss.attendance.list</field>
        <field name="model">bss.attendance</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="attendance_number"/>
                <field name="date"/>
                <field name="class_id"/>
                <field name="subject_id"/>
                <field name="student_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Attendance Form View -->
    <record id="view_attendance_form" model="ir.ui.view">
        <field name="name">bss.attendance.form</field>
        <field name="model">bss.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="attendance_number" readonly="1"/>
                        <field name="class_id"/>
                        <field name="subject_id"/>
                        <field name="date"/>
                        <field name="student_id"/>
                        <field name="status"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
