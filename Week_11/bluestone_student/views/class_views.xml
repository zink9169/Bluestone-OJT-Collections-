<odoo>
    <!-- Class Form View -->
    <record id="view_class_form" model="ir.ui.view">
        <field name="name">bss.class.form</field>
        <field name="model">bss.class</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                        <field name="code" required="1"/>
                        <field name="subject_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Optional: Class List View -->
    <record id="view_class_list" model="ir.ui.view">
        <field name="name">bss.class.list</field>
        <field name="model">bss.class</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>
</odoo>
