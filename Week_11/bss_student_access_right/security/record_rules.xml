<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1"> <record id="rule_bss_student_student_self" model="ir.rule">
            <field name="name">Student: See Own Profile</field>
            <field name="model_id" ref="bluestone_student.model_bss_student"/>
            <field name="groups" eval="[(4, ref('bss_student_access_right.group_school_student'))]"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="True"/> <field name="perm_unlink" eval="False"/>
        </record>

        <record id="rule_bss_attendance_student_self" model="ir.rule">
            <field name="name">Student: See Own Attendance</field>
            <field name="model_id" ref="bluestone_student.model_bss_attendance"/>
            <field name="groups" eval="[(4, ref('bss_student_access_right.group_school_student'))]"/>
            <field name="domain_force">[('student_id.user_id', '=', user.id)]</field>
            <field name="perm_read" eval="True"/>
            <field name="perm_write" eval="False"/>
            <field name="perm_create" eval="False"/>
            <field name="perm_unlink" eval="False"/>
        </record>
    </data>
</odoo>