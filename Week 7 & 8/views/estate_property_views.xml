<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Property List View -->
    <record id="view_estate_property_list" model="ir.ui.view">
        <field name="name">estate.property.list</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="property_type_id"/>
                <field name="tag_ids" widget="many2many_tags"/>
                <field name="expected_price"/>
                <field name="best_price"/>
                <field name="selling_price"/>
                <field name="bedrooms"/>
                <field name="total_area"/>
                <field name="date_availability"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <!-- Property Form View -->
    <record id="view_estate_property_form" model="ir.ui.view">
        <field name="name">estate.property.form</field>
        <field name="model">estate.property</field>
        <field name="arch" type="xml">
            <form>

                <!-- Header Buttons -->
                <header>
                    <button name="action_sold"
                            type="object"
                            string="Mark as Sold"
                            class="btn-primary"
                            invisible="state in ('sold','canceled')"/>
                    <button name="action_cancel"
                            type="object"
                            string="Cancel"
                            class="btn-secondary"
                            invisible="state in ('sold','canceled')"/>
                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="new,offer_received,offer_accepted,sold"/>
                </header>

                <sheet>
                    <!-- Property Title -->
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Property Name"/></h1>
                    </div>

                    <!-- Notebook with fewer tabs -->
                    <notebook>

                        <!-- General Info -->
                        <page string="General Info">
                            <group>
                                <field name="description"/>
                                <field name="postcode"/>
                                <field name="date_availability"/>
                                <field name="expected_price"/>
                                <field name="selling_price"/>
                                <field name="best_price"/>
                                <field name="bedrooms"/>
                                <field name="living_area"/>
                                <field name="total_area"/>
                            </group>
                        </page>

                        <!-- Features & Relations -->
                        <page string="Features">
                            <group>
                                <field name="facades"/>
                                <field name="garage"/>
                                <field name="garden"/>
                                <field name="garden_area"/>
                                <field name="garden_orientation"/>
                                <field name="property_type_id"/>
                                <field name="tag_ids" widget="many2many_tags"/>
                                <field name="seller_id"/>
                                <field name="buyer_id"/>
                            </group>
                        </page>

                        <!-- Offers -->
                        <page string="Offers">
                            <field name="offer_ids">
                                <list editable="bottom">
                                    <field name="price"/>
                                    <field name="partner_id"/>
                                    <field name="validity"/>
                                    <field name="date_deadline"/>
                                    <field name="status"/>
                                    <button name="action_accept" type="object" string="Accept" class="oe_highlight"/>
                                    <button name="action_refuse" type="object" string="Refuse" class="oe_stat_button"/>
                                </list>
                            </field>
                        </page>

                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_estate_property" model="ir.actions.act_window">
        <field name="name">Properties</field>
        <field name="res_model">estate.property</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
