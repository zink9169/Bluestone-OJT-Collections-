<odoo>

    <record id="rule_student_user_own_student" model="ir.rule">
        <field name="name">Student User Own Profile</field>
        <field name="model_id" ref="student.model_school_student"/>
        <field name="groups" eval="[(4, ref('bss_student_access_right.group_student_user'))]"/>
        <!-- group_student_admin ကိုချန်လွှတ်ဖို့ -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
        <field name="domain_force">[('user_id','=',user.id)]</field>
    </record>

    <!-- Student Admin အတွက် သီးသန့် rule - အကုန်မြင်ရမယ် -->
    <record id="rule_student_admin_all_students" model="ir.rule">
        <field name="name">Student Admin All Students</field>
        <field name="model_id" ref="student.model_school_student"/>
        <field name="groups" eval="[(4, ref('bss_student_access_right.group_student_admin'))]"/>
        <field name="domain_force">[(1,'=',1)]</field>  <!-- အကုန်မြင်ရမယ် -->
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>

</odoo>