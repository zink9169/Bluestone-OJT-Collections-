<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="my_todo_app.TodoApp" owl="1">
        <div class="o_todo_container p-4 shadow-sm bg-white m-3">
            <h2 class="text-primary mb-3">Owl Todo List</h2>

            <div class="input-group mb-3">
                <input type="text" class="form-control"
                       placeholder="Add Something ..."
                       t-model="state.newTask"
                       t-on-keydown="onInputKeydown"/>
                <button class="btn btn-primary" t-on-click="addTask">
                    <i class="fa fa-plus"/> Add
                </button>
            </div>

            <ul class="list-group">
                <t t-foreach="state.tasks" t-as="task" t-key="task.id">
                    <li class="list-group-item d-flex justify-content-between align-items-center">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   t-att-id="'task_' + task.id"
                                   t-on-change="() => this.toggleTask(task.id)"/>
                            <label class="form-check-label" t-att-for="'task_' + task.id"
                                   t-att-class="task.isCompleted ? 'text-decoration-line-through text-muted' : ''">
                                <t t-esc="task.text"/>
                            </label>
                        </div>
                        <button class="btn btn-link text-danger p-0" t-on-click="() => this.deleteTask(task.id)">
                            <i class="fa fa-trash"/>
                        </button>
                    </li>
                </t>
            </ul>

            <div class="mt-3 text-muted small">
                Total Tasks: <t t-esc="state.tasks.length"/>
            </div>
        </div>
    </t>
</templates>