<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Student Number Sequence -->
        <record id="seq_student_number" model="ir.sequence">
            <field name="name">Student Number Sequence</field>
            <field name="code">student.number.seq</field>
            <field name="prefix">STD/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Attendance Number Sequence -->
        <record id="seq_attendance_number" model="ir.sequence">
            <field name="name">Attendance Number Sequence</field>
            <field name="code">attendance.number.seq</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>