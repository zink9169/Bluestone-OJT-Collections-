<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_bss_subject_list" model="ir.ui.view">
        <field name="name">bss.subject.list</field>
        <field name="model">bss.subject</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bss_subject_form" model="ir.ui.view">
        <field name="name">bss.subject.form</field>
        <field name="model">bss.subject</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name" required="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bss_subject" model="ir.actions.act_window">
        <field name="name">Subjects</field>
        <field name="res_model">bss.subject</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_bss_subject"
              name="Subjects"
              parent="menu_student_root"
              action="action_bss_subject"
              sequence="40"/>
</odoo>