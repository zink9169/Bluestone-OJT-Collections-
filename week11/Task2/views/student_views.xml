<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_student_list" model="ir.ui.view">
        <field name="name">bss.student.list</field>
        <field name="model">bss.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="student_number"/>
                <field name="name"/>
                <field name="contact_person_name"/>
                <field name="class_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_student_form" model="ir.ui.view">
        <field name="name">bss.student.form</field>
        <field name="model">bss.student</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="student_number" readonly="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="name" required="1"/>
                            <field name="user_id"/>
                        </group>
                        <group>
                            <field name="contact_person_name"/>
                        </group>
                    </group>
                    <group string="Classes">
                        <field name="class_ids" widget="many2many_tags"/>
                    </group>
                    <group string="Subjects">
                        <field name="subject_ids" widget="many2many_tags"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_student_search" model="ir.ui.view">
        <field name="name">bss.student.search</field>
        <field name="model">bss.student</field>
        <field name="arch" type="xml">
            <search>
                <field name="student_number"/>
                <field name="name"/>
                <field name="contact_person_name"/>
                <field name="class_ids"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">bss.student</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_student_search"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_student_list"
              name="Students"
              parent="menu_student_root"
              action="action_student"
              sequence="10"/>
</odoo>