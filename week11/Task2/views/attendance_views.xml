<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List View -->
    <record id="view_bss_attendance_list" model="ir.ui.view">
        <field name="name">bss.attendance.list</field>
        <field name="model">bss.attendance</field>
        <field name="arch" type="xml">
            <list>
                <field name="attendance_number"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="date"/>
                <field name="status"/>
                <field name="notes"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_bss_attendance_form" model="ir.ui.view">
        <field name="name">bss.attendance.form</field>
        <field name="model">bss.attendance</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="attendance_number" readonly="1"/>
                    </group>
                    <group>
                        <group>
                            <field name="student_id" required="1"/>
                            <field name="class_id"/>
                        </group>
                        <group>
                            <field name="date" required="1"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group>
                        <field name="notes"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_bss_attendance_search" model="ir.ui.view">
        <field name="name">bss.attendance.search</field>
        <field name="model">bss.attendance</field>
        <field name="arch" type="xml">
            <search>
                <field name="attendance_number"/>
                <field name="student_id"/>
                <field name="class_id"/>
                <field name="status"/>
                <field name="date"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_bss_attendance" model="ir.actions.act_window">
        <field name="name">Attendance</field>
        <field name="res_model">bss.attendance</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_bss_attendance_search"/>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_bss_attendance"
              name="Attendance"
              parent="menu_student_root"
              action="action_bss_attendance"
              sequence="30"/>
</odoo>