<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">

    <t t-name="odoo_owl.Template">
<div class="o_owl d-flex justify-content-center pt-2">
    <div class="p-2 text-center card" style="width: 40rem;">

        <div class="d-flex justify-content-around p-3">
            <div class="card m-2" style="width: 18rem;">
                <div class="card-body text-center">
                    <h4 class="card-title">Counter 1</h4>
                    <p class="card-text fs-4">
                        Value: <t t-esc="state.count"/>
                    </p>
                    <button class="btn btn-primary me-2" t-on-click="increment">
                        Increment
                    </button>
                    <button class="btn btn-danger" t-on-click="decrement">
                        Decrement
                    </button>
                </div>
            </div>


            <div class="card m-2" style="width: 18rem;">
                <div class="card-body text-center">
                    <h4 class="card-title">Counter 2</h4>
                    <p class="card-text fs-4">
                        Value: <t t-esc="state.value"/>
                    </p>
                    <button class="btn btn-primary me-2" t-on-click="add">
                        Increment
                    </button>
                    <button class="btn btn-danger" t-on-click="minus">
                        Decrement
                    </button>
                </div>
            </div>
        </div>


        <div class="card-body border-top pt-3 text-center">
            <p class="card-text fs-3 fw-bold">
                Total: <t t-esc="state.result"/>
            </p>
        </div>

    </div>
</div>

        <div class="o_owl d-flex justify-content-center pt-5">
            <div class="p-4">
                <h2>To-Do List</h2>

                <div class="input-group mb-3">
                    <input type="text"
                           class="form-control"
                           placeholder="Enter task"
                           t-model="state.newTask"
                           t-on-keydown="onKeydown"/>
                    <button class="btn btn-primary" t-on-click="addTask">
                        <t t-esc="state.editIndex !== null ? 'Update' : 'Add'"/>
                    </button>
                </div>

                <ul class="list-group">
                    <t t-foreach="state.tasks" t-as="task" t-key="task.id">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            <div class="d-flex align-items-center">
                                <input type="checkbox"
                                       class="form-check-input me-2"
                                       t-att-checked="task.done"
                                       t-on-change="toggleDone.bind(this, task)"/>

                                <span t-att-class="task.done ? 'text-decoration-line-through text-muted' : ''"
                                      t-esc="task.text"/>
                            </div>

                            <div>

                                <button class="btn btn-sm btn-warning me-2"
                                        t-on-click="editTask.bind(this, task)">
                                    Edit
                                </button>


                                <button class="btn btn-sm btn-danger"
                                        t-on-click="deleteTask.bind(this, task)">
                                    Delete
                                </button>
                            </div>
                        </li>
                    </t>

                    <t t-if="state.tasks.length === 0">
                        <li class="list-group-item text-center text-muted">
                            No tasks yet. Add one above!
                        </li>
                    </t>
                </ul>

                <t t-if="state.tasks.length > 0">
                    <div class="mt-3">
                        <small class="text-muted">
                            <t t-esc="state.tasks.filter(t => t.done).length"/>
                            of
                            <t t-esc="state.tasks.length"/>
                            tasks completed
                        </small>
                    </div>
                </t>
            </div>
        </div>
    </t>

</templates>